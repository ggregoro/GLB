#!/usr/bin/env bash
#
# ============================================================
# GLB - Greg's Linux Bootstrap
# Main Program
# ============================================================

# Project root directory (resolve symlinks - glb is meant to be run via
# a symlink at ~/.local/bin/glb, see lib/completions.sh)
GLB_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

# Read version
GLB_VERSION="$(<"$GLB_ROOT/VERSION")"

# Load modules
source "$GLB_ROOT/lib/banner.sh"
source "$GLB_ROOT/lib/logging.sh"
source "$GLB_ROOT/lib/utils.sh"
source "$GLB_ROOT/lib/detect.sh"
source "$GLB_ROOT/lib/package.sh"
source "$GLB_ROOT/lib/extras.sh"
source "$GLB_ROOT/lib/profile.sh"
source "$GLB_ROOT/lib/export.sh"
source "$GLB_ROOT/lib/diff.sh"
source "$GLB_ROOT/lib/prompt.sh"
source "$GLB_ROOT/lib/plugins.sh"
source "$GLB_ROOT/lib/completions.sh"

# ------------------------------------------------------------
# Display help
# ------------------------------------------------------------

glb_show_help() {
    printf "\n"
    printf "Usage:\n"
    printf "  glb <command>\n"
    printf "\n"
    printf "Commands:\n"
    printf "  help       Show this help message\n"
    printf "  version    Show GLB version\n"
    printf "  info       Show system information\n"
    printf "  install    Install a package\n"
    printf "  remove     Remove a package\n"
    printf "  update     Update all system packages\n"
    printf "  restore    Apply a profile (packages + dotfiles)\n"
    printf "  restore              With no profile name, choose one interactively\n"
    printf "  restore --undo       Undo the last restore's dotfile changes\n"
    printf "  restore --dry-run    Preview what a restore would do, without changing anything\n"
    printf "  profiles   List available profiles\n"
    printf "  prompt     Install and configure the Starship shell prompt\n"
    printf "  export     Capture this machine's packages/dotfiles into snapshots/\n"
    printf "  diff       Compare two profiles/snapshots for package + dotfile drift\n"
    printf "\n"
}

# ------------------------------------------------------------
# Display system information
# ------------------------------------------------------------

glb_show_info() {
    local os
    local version
    local package_manager
    local shell

    os="$(glb_detect_os)"
    version="$(glb_detect_version)"
    package_manager="$(glb_detect_package_manager)"
    shell="$(glb_detect_shell)"

    printf "\n"
    printf "System Information\n"
    printf -- "------------------\n"
    printf "Distribution:    %s\n" "$os"
    printf "Version:         %s\n" "$version"
    printf "Package Manager: %s\n" "$package_manager"
    printf "Shell:           %s\n" "$shell"
    printf "\n"
}

# ------------------------------------------------------------
# Main program
# ------------------------------------------------------------

glb_show_banner "$GLB_VERSION"

case "${1:-}" in
    help)
        glb_show_help
        ;;

    version)
        printf "GLB Version %s\n" "$GLB_VERSION"
        ;;

    info)
        glb_show_info
        ;;
    install)
        glb_install_package "${2:-}"
        ;;

    remove)
        glb_remove_package "${2:-}"
        ;;

    update)
        glb_update_packages
        ;;

    restore)
        if [[ "${2:-}" == "--undo" ]]; then
            glb_undo_restore
        else
            restore_profile=""
            restore_dry_run=""
            for restore_arg in "${@:2}"; do
                if [[ "$restore_arg" == "--dry-run" ]]; then
                    restore_dry_run="--dry-run"
                else
                    restore_profile="$restore_arg"
                fi
            done
            if [[ -z "$restore_profile" ]]; then
                glb_restore_interactive "$restore_dry_run"
            else
                glb_apply_profile "$restore_profile" "$restore_dry_run"
            fi
        fi
        ;;

    profiles)
        glb_list_profiles
        ;;

    prompt)
        glb_setup_prompt
        ;;

    export)
        glb_export_snapshot
        ;;

    diff)
        glb_diff_snapshot "${2:-}" "${3:-}"
        ;;

    "")
        glb_show_help
        ;;

    *)
        glb_log_error "Unknown command: $1"
        glb_show_help
        exit 1
        ;;
esac
