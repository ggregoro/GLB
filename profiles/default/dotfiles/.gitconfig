# Personal identity is intentionally not set here - this file is
# shared publicly as part of GLB's default profile, and anyone
# restoring it shouldn't get someone else's name/email on their
# commits. Create ~/.gitconfig.local with your own [user] section;
# git includes it automatically if present, and silently skips it
# if it's missing.
[include]
	path = ~/.gitconfig.local

# git-delta (installed via packages.txt) - a syntax-highlighting diff
# pager. The `command -v` guard means a machine where the package
# wasn't installed yet (this file is a live symlink) silently pages
# with plain less, no "delta: not found" noise on every git diff.
[core]
	pager = command -v delta >/dev/null 2>&1 && delta || less
[interactive]
	diffFilter = command -v delta >/dev/null 2>&1 && delta --color-only || cat
[delta]
	navigate = true
	line-numbers = true
[merge]
	conflictStyle = zdiff3
