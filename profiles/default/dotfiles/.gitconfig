# Personal identity is intentionally not set here - this file is
# shared publicly as part of GLB's default profile, and anyone
# restoring it shouldn't get someone else's name/email on their
# commits. Create ~/.gitconfig.local with your own [user] section;
# git includes it automatically if present, and silently skips it
# if it's missing.
[include]
	path = ~/.gitconfig.local

# git-delta (installed via packages.txt) - a syntax-highlighting diff
# pager. `delta || less` so a machine where the package wasn't
# installed still pages with plain less instead of erroring.
[core]
	pager = delta || less
[interactive]
	diffFilter = delta --color-only || cat
[delta]
	navigate = true
	line-numbers = true
[merge]
	conflictStyle = zdiff3
