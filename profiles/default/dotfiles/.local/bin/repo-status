#!/usr/bin/env bash
# Show the state of every git repo under ~/Projects as a colored table:
# branch, clean or has changes, and whether it is in sync with its
# remote. It fetches but never pulls, so running it changes nothing.

projects="$HOME/Projects"

# Colors. Each one is a code the terminal reads as "switch color".
# They use the terminal's own palette, so they follow the theme.
bold=$'\e[1m'
dim=$'\e[2m'
red=$'\e[31m'
green=$'\e[32m'
yellow=$'\e[33m'
blue=$'\e[34m'
cyan=$'\e[36m'
reset=$'\e[0m'

# The box. Three ready-made horizontal lines (top, middle, bottom) and
# one upright bar that goes between the columns of every row. The
# lines are exactly as wide as the columns below: 30, 10, 14 and 11
# characters, plus one space of padding on each side.
top="┌────────────────────────────────┬────────────┬────────────────┬─────────────┐"
mid="├────────────────────────────────┼────────────┼────────────────┼─────────────┤"
bot="└────────────────────────────────┴────────────┴────────────────┴─────────────┘"
bar="${dim}│${reset}"

# Header. %-30s means "text, left-aligned, padded to 30 characters".
# That padding is what makes the columns line up.
printf -v h_repo "%-30s" "REPO"
printf -v h_branch "%-10s" "BRANCH"
printf -v h_state "%-14s" "STATE"
printf -v h_sync "%-11s" "SYNC"
head_color="${bold}${blue}"

echo
echo "  ${dim}${top}${reset}"
echo "  ${bar} ${head_color}${h_repo}${reset} ${bar} ${head_color}${h_branch}${reset} ${bar} ${head_color}${h_state}${reset} ${bar} ${head_color}${h_sync}${reset} ${bar}"
echo "  ${dim}${mid}${reset}"

total=0
dirty=0

for dir in "$projects"/*/; do
  if [ ! -d "$dir/.git" ]; then
    continue
  fi

  name=$(basename "$dir")
  branch=$(git -C "$dir" branch --show-current)
  changes=$(git -C "$dir" status --porcelain)

  # 2>/dev/null hides git's error text. With no network the fetch
  # fails, and a branch that was never pushed has no upstream ("@{u}")
  # to compare with; in that case ahead stays empty.
  git -C "$dir" fetch --quiet 2>/dev/null
  ahead=$(git -C "$dir" rev-list --count "@{u}..HEAD" 2>/dev/null)
  behind=$(git -C "$dir" rev-list --count "HEAD..@{u}" 2>/dev/null)

  if [ -n "$changes" ]; then
    mark="●"
    state="has changes"
    state_color=$yellow
    dirty=$((dirty + 1))
  else
    mark="✓"
    state="clean"
    state_color=$green
  fi

  # sync_plain is the same text with plain letters instead of arrows.
  # It is only used to count how wide the cell is.
  if [ -z "$ahead" ]; then
    sync="no upstream"
    sync_plain="no upstream"
    sync_color=$yellow
  elif [ "$ahead" -eq 0 ] && [ "$behind" -eq 0 ]; then
    sync="in sync"
    sync_plain="in sync"
    sync_color=$dim
  else
    sync="↑$ahead ↓$behind"
    sync_plain="^$ahead v$behind"
    sync_color=$red
  fi

  # Pad each cell to its column width first, then color it. Coloring
  # first would throw the columns off, because the color codes count
  # as characters even though they are invisible.
  printf -v name_cell "%-30s" "$name"
  printf -v branch_cell "%-10s" "$branch"
  printf -v state_cell "%-12s" "$state"
  printf -v sync_pad "%*s" $((11 - ${#sync_plain})) ""

  echo "  ${bar} ${bold}${name_cell}${reset} ${bar} ${cyan}${branch_cell}${reset} ${bar} ${state_color}${mark} ${state_cell}${reset} ${bar} ${sync_color}${sync}${reset}${sync_pad} ${bar}"

  total=$((total + 1))
done

echo "  ${dim}${bot}${reset}"
echo "  ${dim}$total repos, $dirty with changes${reset}"
echo
