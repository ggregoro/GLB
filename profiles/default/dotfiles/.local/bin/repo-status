#!/usr/bin/env bash
# Show the state of every git repo under ~/Projects as a colored table:
# branch, clean or has changes, and whether it is in sync with its
# remote. It fetches but never pulls, so running it changes nothing.

projects="$HOME/Projects"

# Colors. Each one is a code the terminal reads as "switch color".
# They use the terminal's own palette, so they follow the theme.
bold=$'\e[1m'
dim=$'\e[2m'
red=$'\e[31m'
green=$'\e[32m'
yellow=$'\e[33m'
blue=$'\e[34m'
cyan=$'\e[36m'
reset=$'\e[0m'

bar="${dim}│${reset}"

# The table is drawn in two passes. First every repo is checked and its
# cells are stored; then each column is made exactly as wide as its
# longest entry (or its header), so there is no wasted space.
names=() branches=() states=() state_colors=() syncs=() sync_plains=() sync_colors=()
total=0
dirty=0

# Ask every remote for news first, all at the same time: one at a time
# took about half a second per repo, mostly waiting on the network.
# The & starts each fetch in the background and wait holds until all
# of them are done. GIT_TERMINAL_PROMPT=0 makes a repo that would ask
# for a password fail quietly instead (prompts from several fetches
# at once would garble the screen). 2>/dev/null hides git's error
# text: with no network the fetches fail and the table shows the last
# known state.
for dir in "$projects"/*/; do
  [ -d "$dir/.git" ] && GIT_TERMINAL_PROMPT=0 git -C "$dir" fetch --quiet 2>/dev/null &
done
wait

for dir in "$projects"/*/; do
  if [ ! -d "$dir/.git" ]; then
    continue
  fi

  name=$(basename "$dir")
  branch=$(git -C "$dir" branch --show-current)
  changes=$(git -C "$dir" status --porcelain)

  # A branch that was never pushed has no upstream ("@{u}") to compare
  # with; 2>/dev/null hides git's complaint and ahead stays empty.
  ahead=$(git -C "$dir" rev-list --count "@{u}..HEAD" 2>/dev/null)
  behind=$(git -C "$dir" rev-list --count "HEAD..@{u}" 2>/dev/null)

  if [ -n "$changes" ]; then
    state="● has changes"
    state_color=$yellow
    dirty=$((dirty + 1))
  else
    state="✓ clean"
    state_color=$green
  fi

  # sync_plain is the same text with plain letters instead of arrows.
  # It is only used to count how wide the cell is.
  if [ -z "$ahead" ]; then
    sync="no upstream"; sync_plain=$sync; sync_color=$yellow
  elif [ "$ahead" -eq 0 ] && [ "$behind" -eq 0 ]; then
    sync="in sync"; sync_plain=$sync; sync_color=$dim
  else
    sync="↑$ahead ↓$behind"; sync_plain="^$ahead v$behind"; sync_color=$red
  fi

  names+=("$name"); branches+=("$branch")
  states+=("$state"); state_colors+=("$state_color")
  syncs+=("$sync"); sync_plains+=("$sync_plain"); sync_colors+=("$sync_color")
  total=$((total + 1))
done

# Column widths: start at the header's width, grow to the longest cell.
# The state cells start with a one-character mark (✓ or ●); the mark is
# swapped for a plain letter before counting, in case the terminal's
# locale counts it as more than one character.
w_repo=4 w_branch=6 w_state=5 w_sync=4
for i in "${!names[@]}"; do
  s="x${states[i]#?}"
  (( ${#names[i]} > w_repo )) && w_repo=${#names[i]}
  (( ${#branches[i]} > w_branch )) && w_branch=${#branches[i]}
  (( ${#s} > w_state )) && w_state=${#s}
  (( ${#sync_plains[i]} > w_sync )) && w_sync=${#sync_plains[i]}
done

# A horizontal line: n copies of ─, plus one on each side for padding.
line() { local s; printf -v s "%*s" $(($1 + 2)) ""; printf '%s' "${s// /─}"; }
top="┌$(line $w_repo)┬$(line $w_branch)┬$(line $w_state)┬$(line $w_sync)┐"
mid="├$(line $w_repo)┼$(line $w_branch)┼$(line $w_state)┼$(line $w_sync)┤"
bot="└$(line $w_repo)┴$(line $w_branch)┴$(line $w_state)┴$(line $w_sync)┘"

# Pad each cell to its column width first, then color it. Coloring
# first would throw the columns off, because the color codes count as
# characters even though they are invisible. %-*s means "text,
# left-aligned, padded to the width given before it".
head_color="${bold}${blue}"
printf -v h "  ${bar} ${head_color}%-*s${reset} ${bar} ${head_color}%-*s${reset} ${bar} ${head_color}%-*s${reset} ${bar} ${head_color}%-*s${reset} ${bar}" \
  "$w_repo" REPO "$w_branch" BRANCH "$w_state" STATE "$w_sync" SYNC

echo
echo "  ${dim}${top}${reset}"
echo "$h"
echo "  ${dim}${mid}${reset}"

for i in "${!names[@]}"; do
  s="x${states[i]#?}"
  printf -v name_cell "%-*s" "$w_repo" "${names[i]}"
  printf -v branch_cell "%-*s" "$w_branch" "${branches[i]}"
  printf -v state_pad "%*s" $((w_state - ${#s})) ""
  printf -v sync_pad "%*s" $((w_sync - ${#sync_plains[i]})) ""
  echo "  ${bar} ${bold}${name_cell}${reset} ${bar} ${cyan}${branch_cell}${reset} ${bar} ${state_colors[i]}${states[i]}${reset}${state_pad} ${bar} ${sync_colors[i]}${syncs[i]}${reset}${sync_pad} ${bar}"
done

echo "  ${dim}${bot}${reset}"
echo "  ${dim}$total repos, $dirty with changes${reset}"
echo
